{
  "name": "@nodari-pruidze/form-builder-js",
  "version": "0.2.0",
  "description": "JSON-driven React forms with Zod validation, conditional fields, multi-step wizards and server-side re-validation. Styled with Tailwind CSS v4.",
  "license": "MIT",
  "author": "Nodari Pruidze",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodi100/form-builder-js.git",
    "directory": "packages/form-builder"
  },
  "homepage": "https://github.com/nodi100/form-builder-js/tree/main/packages/form-builder#readme",
  "bugs": "https://github.com/nodi100/form-builder-js/issues",
  "keywords": [
    "form",
    "form-builder",
    "json-schema",
    "react",
    "react-hook-form",
    "zod",
    "tailwindcss",
    "nextjs",
    "multi-step",
    "wizard"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@hookform/resolvers": "^5.1.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-hook-form": "^7.55.0",
    "tailwindcss": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.2.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.60.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
